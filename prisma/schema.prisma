// claimIT database schema.
// Auth tables (User/Session/Account/Verification) are owned by Better Auth —
// shape and field names come from its own schema generator
// (`npx auth@latest generate`), not hand-written. Re-run that generator
// after changing plugins/providers in src/lib/auth.ts, then reconcile here.
//
// Escrow model: pooled treasury wallets (Circle Developer-Controlled) + this
// ledger, rather than one on-chain wallet per link. See architecture notes
// for the double-spend/duplicate-claim guarantees this schema enforces.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isAnonymous   Boolean? @default(false)
  sessions      Session[]
  accounts      Account[]

  // claimIT domain fields/relations (not part of Better Auth's core schema).
  // Nullable: Better Auth creates the User row on sign-up/sign-in and knows
  // nothing about Circle. A Circle wallet is provisioned and backfilled here
  // right after, via a Better Auth database hook (see Milestone 4).
  circleUserId    String?         @unique
  wallets         Wallet[]
  sentLinks       PaymentLink[]   @relation("SentLinks")
  sentBatches     LinkBatch[]     @relation("SentBatches")
  walletAddresses WalletAddress[]
  claims          Claim[]
  auditLogs       AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Owned by Better Auth's siwe plugin, which addresses it as `walletAddress`
/// — the Prisma model name has to stay WalletAddress for `prisma.walletAddress`
/// to resolve. Distinct from the domain `Wallet` model: this records "this
/// address proves this account's identity", not "this is a wallet we can move
/// funds through" — signing in with a wallet still provisions a normal
/// Circle-managed Wallet the same as any other login method.
model WalletAddress {
  id        String   @id
  userId    String
  address   String
  chainId   Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([address, chainId])
  @@index([userId])
  @@map("walletAddress")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CustodyType {
  USER_CONTROLLED
  DEVELOPER_CONTROLLED
}

enum WalletRole {
  PERSONAL
  TREASURY
}

model Wallet {
  id             String      @id @default(cuid())
  userId         String?
  custodyType    CustodyType
  role           WalletRole
  circleWalletId String      @unique
  address        String      @unique
  blockchain     String      @default("ARC-TESTNET")
  accountType    String
  walletSetId    String?
  createdAt      DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([role])
}

enum LinkStatus {
  PENDING_DEPOSIT
  ACTIVE
  CLAIMED
  EXPIRED
  CANCELLED
}

enum BatchStatus {
  PENDING_DEPOSIT
  ACTIVE
  FAILED
}

/// A giveaway: one deposit funding many links at once.
///
/// Exists because a batch can't be modelled as N independent links sharing a
/// deposit — PaymentLink.refId is unique and a Transaction belongs to one
/// link, both deliberately, since that 1:1 tie is what makes single-link
/// reconciliation unambiguous. The batch owns the refId and the deposit
/// instead, and its links carry only their own share.
model LinkBatch {
  id               String      @id @default(cuid())
  senderId         String
  treasuryWalletId String
  /// The sum the sender is asked to deposit. Activation requires the
  /// confirmed on-chain amount to cover it — see confirmBatchDeposit.
  totalMicros      BigInt
  linkCount        Int
  status           BatchStatus @default(PENDING_DEPOSIT)
  refId            String?     @unique
  depositTxId      String?
  /// What actually arrived on-chain, which is the number that matters if it
  /// ever disagrees with totalMicros.
  depositedMicros  BigInt?
  createdAt        DateTime    @default(now())

  sender       User          @relation("SentBatches", fields: [senderId], references: [id])
  links        PaymentLink[]
  transactions Transaction[]

  @@index([senderId])
  @@index([status, createdAt])
}

model PaymentLink {
  id               String     @id @default(cuid())
  tokenHash        String     @unique
  senderId         String
  treasuryWalletId String
  amountMicros     BigInt
  status           LinkStatus @default(PENDING_DEPOSIT)
  passwordHash     String?
  expiresAt        DateTime?
  depositTxId      String?
  // Ties this row to the on-chain deposit before it's confirmed. Only
  // meaningful while status = PENDING_DEPOSIT; the reconciliation job uses
  // it to find the transaction if the synchronous confirm never completes.
  // Null for links funded as part of a batch — the batch holds the refId.
  refId            String?    @unique
  // Set for links created as part of a giveaway; null for standalone links.
  batchId          String?
  createdAt        DateTime   @default(now())
  claimedAt        DateTime?

  sender       User          @relation("SentLinks", fields: [senderId], references: [id])
  batch        LinkBatch?    @relation(fields: [batchId], references: [id])
  claim        Claim?
  transactions Transaction[]

  @@index([senderId])
  @@index([batchId])
  @@index([status, expiresAt])
  @@index([status, createdAt])
}

enum ClaimStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Claim {
  id            String      @id @default(cuid())
  paymentLinkId String      @unique
  claimantId    String
  status        ClaimStatus @default(PENDING)
  circleTxId    String?
  failReason    String?
  ipAddress     String
  userAgent     String?
  createdAt     DateTime    @default(now())

  paymentLink PaymentLink @relation(fields: [paymentLinkId], references: [id])
  claimant    User        @relation(fields: [claimantId], references: [id])

  @@index([claimantId])
}

enum TxType {
  DEPOSIT
  PAYOUT
  REFUND
}

model Transaction {
  id            String   @id @default(cuid())
  // Exactly one of these is set: a payout belongs to a link, while a batch
  // deposit funds many links at once and so belongs to the batch.
  paymentLinkId String?
  batchId       String?
  type          TxType
  circleTxId    String   @unique
  fromAddress   String
  toAddress     String
  amountMicros  BigInt
  gasFeeMicros  BigInt?
  status        String
  rawWebhook    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id])
  batch       LinkBatch?   @relation(fields: [batchId], references: [id])

  @@index([paymentLinkId])
  @@index([batchId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId])
}
