# Copy to .env and fill in. Never commit real secrets.

# --- Database (Milestone 2) ---
# Local dev: `docker compose up -d`, then use the value below as-is.
DATABASE_URL="postgresql://claimit:claimit@localhost:5432/claimit?schema=public"

# --- Better Auth (Milestone 3) ---
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (developer.apple.com — requires a paid Apple Developer account).
# Apple does not support localhost/non-HTTPS; needs a tunnel (e.g. ngrok) or a
# deployed HTTPS URL to test locally.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# Email OTP delivery (resend.com)
RESEND_API_KEY=
EMAIL_FROM="claimIT <onboarding@resend.dev>"

# --- Circle: User-Controlled Wallets (Milestone 4) ---
# console.circle.com > Project Settings for the API key;
# Wallets > User Controlled > Configurator for the App ID (not secret, safe
# to expose to the browser — the SDK needs it client-side).
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=

# --- Circle: Developer-Controlled Wallets — treasury escrow (Milestone 4/5) ---
# Generate with scripts/register-entity-secret.ts (run once, by you, never by
# an agent — see that script's comments). Never commit the recovery file.
CIRCLE_ENTITY_SECRET=
CIRCLE_TREASURY_WALLET_SET_ID=

# --- Circle webhooks (Milestone 5) ---
# No env var needed — verification fetches the public key per keyId from
# Circle's API (cached in memory), authenticated with CIRCLE_API_KEY above.
# Register the subscription with:
#   curl -X POST https://api.circle.com/v2/notifications/subscriptions \
#     -H "Authorization: Bearer $CIRCLE_API_KEY" -H "Content-Type: application/json" \
#     -d '{"endpoint": "https://<your-public-url>/api/webhooks/circle", "notificationTypes": ["*"]}'
# Requires a public HTTPS URL — localhost won't work; use a tunnel (e.g.
# ngrok) for local testing, same constraint as Apple Sign In.

# --- Deposit reconciliation cron (Milestone 6) ---
# Shared secret for POST /api/cron/reconcile-deposits. Generate with e.g.
# `openssl rand -hex 32` — use a different value per environment (dev vs
# prod), same reasoning as BETTER_AUTH_SECRET. Real scheduling needs Vercel
# Cron (or any external scheduler) hitting that endpoint with this as a
# Bearer token — wire that up at deploy time; invoke the route manually for
# local testing until then.
CRON_SECRET=
