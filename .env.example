# Copy to .env and fill in. Never commit real secrets.

# --- Database (Milestone 2) ---
# Local dev: `docker compose up -d`, then use the value below as-is.
DATABASE_URL="postgresql://claimit:claimit@localhost:5432/claimit?schema=public"

# --- NextAuth / Auth.js (Milestone 3) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=

# --- Circle: User-Controlled Wallets (Milestone 4) ---
CIRCLE_API_KEY=
CIRCLE_APP_ID=

# --- Circle: Developer-Controlled Wallets — treasury escrow (Milestone 4/5) ---
CIRCLE_ENTITY_SECRET=
CIRCLE_TREASURY_WALLET_SET_ID=

# --- Circle webhooks (Milestone 5) ---
CIRCLE_WEBHOOK_PUBLIC_KEY=

# --- Arc network (Milestone 5) ---
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
NEXT_PUBLIC_ARC_TESTNET_CHAIN_ID=5042002

# --- Rate limiting (Milestone 7) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
